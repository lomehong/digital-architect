# =============================================================================
#  docker/.env.example · 环境配置模板（可签入 git）
#  用法：cp .env.example .env → 填值 → docker compose up -d（配置变更须重建容器生效）
#  真实 .env 已被 docker/.gitignore 排除，密钥不入库。
#
#  entrypoint 校验语义（docker/entrypoint.sh）：
#    · 空值 / 以 PLACEHOLDER 开头 → DEEPSEEK_API_KEY 拒绝启动（FATAL）；
#    · GH_TOKEN / YUYI_AGENT_TOKEN：缺失仅显式降级（WARN，不阻断）；占位符同 FATAL。
#    · 校验绝不回显密钥值。
# =============================================================================

# ── 现场（workspace = 架构师当前服务的目标项目，v3 大脑/现场解耦）──
# 目标项目宿主路径；切换现场改这里后 up -d
TARGET_PROJECT=E:\path\to\target

# ── 模型 provider 凭据 ──
# DeepSeek（必填：空值容器拒绝启动）
DEEPSEEK_API_KEY=
# 智谱 GLM Coding Plan（可选备用 provider）
ZHIPU_API_KEY=
# Z.AI 国际版套餐（可选备用）
ZAI_API_KEY=

# ── GitHub 凭证（可选：gh CLI / git 私有仓免密；建议细粒度 PAT，仅目标仓 contents 读写）──
GH_TOKEN=

# ── 御驿 Yuyi 通信平面（缺失则通信面自禁用；试点协同必填）──
# 该实例的御符 agent token（omp-ops-pi-01，agentId 5747e738-…）
YUYI_AGENT_TOKEN=
# 御符验证网关基址（扩展自验身份用），按实际部署填写
YUYI_YUFU_URL=
# 云 Hub 地址（内网实测参考：hub.qianji.io；经 TLS 反代则 wss://）
YUYI_HUB=
# 设备名与收件别名（留空用默认 oh-my-pi / omp-docker）
YUYI_DEVICE=oh-my-pi
YUYI_ALIAS=omp-docker

# ── 容器基础（一般不用改）──
PUID=1000
PGID=1000
# 镜像与构建源加速（国内默认；切官方：NODE_IMAGE=node:24-bookworm-slim APT_MIRROR=deb.debian.org NPM_REGISTRY=registry.npmjs.org）
NODE_IMAGE=node:24-bookworm-slim
APT_MIRROR=mirrors.aliyun.com
NPM_REGISTRY=https://registry.npmmirror.com
